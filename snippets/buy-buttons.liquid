{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - selectedVariant: {String} id of the selected variant.

  Usage:
  {% render 'buy-buttons', product: product, selectedVariant: selectedVariant %}
{% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_available = true
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity <= 0
    assign is_available = false
  endif

  if is_available
    assign button_variant_class = 'btn--primary'
  else
    assign button_variant_class = 'btn--outline-primary'
  endif
-%}
<div class="w-full">
  {%- if product != blank -%}
    <div>
      <p
        class="text-red-500 text-center mb-2 font-sans"
        x-data="{message: ''}"
        x-show="message != ''"
        x-text="message"
        @cart:error.window="message = event.detail.message"
        @cart:adding.window="message = ''"
        @cart:added.window="message = ''"
      ></p>
      <button
        type="button"
        x-ref="buyButton"
        class="btn {{ button_variant_class }} w-full relative buy-button"
        x-data="{ loading: false }"
        @cart:adding.window="loading = true"
        @cart:added.window="loading = false"
        @cart:error.window="loading = false"
        {% if is_available %}
          @click="$store.cart.addToCart({{ current_variant.id }})"
          :disabled="loading"
          {% unless product.selected_variant %}
            disabled
          {% endunless %}
        {% else %}
          disabled
        {% endif %}
      >
        <span
          class="transition-opacity duration-500"
          :class="{ 'opacity-0': loading }"
        >
          {% if is_available %}Add to Cart{% else %}Out of Stock{% endif %}
        </span>
        <div
          class="absolute inset-0 flex items-center justify-center"
          x-show="loading"
        >
          {%- render 'loading-spinner' -%}
        </div>
      </button>
    </div>
  {%- endif -%}
</div>
